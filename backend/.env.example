# ============================================================
# SmartLearn Backend Environment Variables Template
# ============================================================
# Copy this file to .env and provide your actual database credentials:
# cp .env.example .env

# PostgreSQL / Supabase Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example (Supabase pooler/direct):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret & Encryption Parameters
# Generate a strong 32+ character secret for production
SECRET_KEY=smartlearn-production-super-secret-key-replace-with-secure-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
